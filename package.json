{
  "name": "@claudiu-ceia/pii-mask",
  "version": "0.2.0",
  "description": "Local PII detection and redaction for TypeScript logs and structured data, with Pino and Winston adapters.",
  "keywords": [
    "data-masking",
    "data-redaction",
    "log-redaction",
    "pii",
    "pii-detection",
    "pii-redaction",
    "pino",
    "privacy",
    "sensitive-data",
    "structured-logging",
    "typescript",
    "winston"
  ],
  "homepage": "https://github.com/ClaudiuCeia/pii-mask#readme",
  "bugs": {
    "url": "https://github.com/ClaudiuCeia/pii-mask/issues"
  },
  "license": "MIT",
  "author": "Claudiu Ceia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClaudiuCeia/pii-mask.git"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pino": {
      "types": "./dist/pino.d.ts",
      "import": "./dist/pino.js"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "import": "./dist/winston.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "bench": "bun run build && bun run scripts/benchmark.ts --module dist/index.js",
    "bench:save": "bun run build && bun run scripts/benchmark.ts --module dist/index.js --json .benchmarks/baseline.json",
    "bench:check": "bun run build && bun run scripts/benchmark.ts --module dist/index.js --json .benchmarks/current.json && bun run scripts/compare-benchmarks.ts .benchmarks/baseline.json .benchmarks/current.json",
    "bench:compare": "bun run scripts/compare-benchmarks.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "coverage": "bun test --coverage ./test",
    "knip": "knip",
    "jsr:smoke": "deno test --allow-env --allow-sys=hostname --no-lock scripts/deno-smoke.ts",
    "package:attw": "attw --pack . --profile esm-only",
    "package:smoke": "bun run build && bun run scripts/package-consumer-smoke.ts --runtime-only",
    "package:check": "bun run build && publint && bun run package:attw && bun run scripts/package-consumer-smoke.ts",
    "prepublishOnly": "bun run scripts/prepublish.ts",
    "prepack": "bun run build",
    "hooks:install": "bun run scripts/hooks.ts install",
    "hooks:uninstall": "bun run scripts/hooks.ts uninstall"
  },
  "dependencies": {
    "@claudiu-ceia/ts-duckling": "0.7.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "1.4.1",
    "knip": "6.34.0",
    "mitata": "1.0.34",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "pino": "10.3.1",
    "publint": "0.3.24",
    "typescript": "~7.0.0",
    "winston": "3.19.0"
  },
  "peerDependencies": {
    "pino": ">=10 <11",
    "winston": ">=3.3 <4"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
