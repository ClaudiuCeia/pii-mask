{
  "name": "@claudiu-ceia/pii-mask",
  "version": "0.1.0",
  "description": "Deterministic PII masking and redaction for TypeScript applications and logs.",
  "keywords": [
    "masking",
    "pii",
    "pino",
    "redaction",
    "typescript",
    "winston"
  ],
  "homepage": "https://github.com/ClaudiuCeia/pii-mask#readme",
  "bugs": {
    "url": "https://github.com/ClaudiuCeia/pii-mask/issues"
  },
  "license": "MIT",
  "author": "Claudiu Ceia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClaudiuCeia/pii-mask.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pino": {
      "types": "./dist/pino.d.ts",
      "import": "./dist/pino.js"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "import": "./dist/winston.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "bench": "bun run build && bun run scripts/benchmark.ts --module dist/index.js",
    "bench:save": "bun run build && bun run scripts/benchmark.ts --module dist/index.js --json .benchmarks/baseline.json",
    "bench:check": "bun run build && bun run scripts/benchmark.ts --module dist/index.js --json .benchmarks/current.json && bun run scripts/compare-benchmarks.ts .benchmarks/baseline.json .benchmarks/current.json",
    "bench:compare": "bun run scripts/compare-benchmarks.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "knip": "knip",
    "package:check": "bun run build && publint && node scripts/package-smoke.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run knip",
    "prepublishOnly": "bun run check && bun run package:check"
  },
  "dependencies": {
    "@claudiu-ceia/ts-duckling": "^0.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "pino": "^10.3.1",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "pino": ">=9 <11",
    "winston": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
